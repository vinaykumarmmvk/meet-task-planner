<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Cache files (CSV, temp attachments, etc.) -->
    <cache-path
        name="cache"
        path="." />

    <!-- App-specific external files (e.g., Downloads/...) for pre-Android 10 downloads -->
    <external-files-path
        name="external_files"
        path="." />

    <!-- Internal files directory (fallback) -->
    <files-path
        name="files"
        path="." />

</paths>
