<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:padding="20dp">

    <!-- Header row: icon + title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <!-- Tiny developer icon (can be person icon or tools icon) -->
        <ImageView
            android:id="@+id/imgDevIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_person_24"
            android:contentDescription="Developer" />

        <TextView
            android:id="@+id/dialogDevTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Developer"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Intro / description -->
    <TextView
        android:id="@+id/dialogDevIntro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#1A1A1A"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp"
        android:text="Hi, I’m Vinay Kumar.

I built Screen Timer to help people stay mindful of how long they’re on their phones and get gentle reminders to take breaks." />

    <!-- Contact label -->
    <TextView
        android:id="@+id/dialogDevContactLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reach me:"
        android:textColor="#000000"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <!-- Contact row: email + LinkedIn -->
    <LinearLayout
        android:id="@+id/contactRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <!-- Email chip -->
        <LinearLayout
            android:id="@+id/btnEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_contact_chip"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_email"
                android:tint="#000000"
                android:contentDescription="Email" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Email"
                android:textColor="#000000"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- LinkedIn chip -->
        <LinearLayout
            android:id="@+id/btnLinkedIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_contact_chip"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_linkedin"
                android:contentDescription="LinkedIn" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="LinkedIn"
                android:textColor="#000000"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Close button -->
    <Button
        android:id="@+id/btnDialogClose"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Got it"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textSize="16sp"/>

</LinearLayout>
