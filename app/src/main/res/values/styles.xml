<resources>
    <!-- For selected tab -->
    <style name="TabTextAppearanceSelected" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/purple_700</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- For unselected tabs -->
    <style name="TabTextAppearanceNormal" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/tab_unselected</item>
    </style>
    <style name="SpinnerPopupTheme" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:popupBackground">@drawable/spinner_popup_bg_white</item>
        <item name="colorControlNormal">@android:color/black</item>
    </style>

</resources>
